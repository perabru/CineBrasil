# Copie para .env e ajuste conforme o MySQL instalado no seu computador.
# No XAMPP local, o usuario 'root' pode estar sem senha (nao use assim em producao).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cinebrasil
PORT=3001
# Em desenvolvimento, se ficar vazio, o servidor cria uma chave TEMPORARIA a cada inicio.
# Para producao, defina uma chave aleatoria longa e HTTPS.
JWT_SECRET=
NODE_ENV=development
